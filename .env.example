# fal.ai image generation (same account as IMK/BBB — see .env.local on those repos)
FAL_KEY=
# Optional: override the fal.ai model id used by scripts/generate-all-images.mjs
# Falls back to fal-ai/nano-banana-pro if unset.
FAL_MODEL=

# Anthropic Messages API — powers the Amy chat widget (netlify/functions/chat.js)
# Same key already exported for this account; set it in Netlify env vars too.
ANTHROPIC_API_KEY=
