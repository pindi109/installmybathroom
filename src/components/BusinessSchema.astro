---
// Site-wide HomeAndConstructionBusiness identity. @id matches the full node on the
// homepage so Google merges them into one entity rather than seeing two businesses.
// No streetAddress anywhere — locality/region/postcode only (brief §0.2).
import { business, entityOneLiner } from "../config/business.ts";
import areasData from "../data/areas.json";

const schema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": `${business.url}/#business`,
  "name": business.name,
  "url": business.url,
  "telephone": business.phoneE164,
  "email": business.email,
  "description": entityOneLiner,
  "priceRange": "££££",
  "image": `${business.url}/brand/imb-logo.webp`,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": business.locality,
    "addressRegion": business.region,
    "postalCode": business.postcode,
    "addressCountry": business.country
  },
  "areaServed": areasData.priority
    .slice()
    .sort((a: { rank: number }, b: { rank: number }) => a.rank - b.rank)
    .map((a: { name: string }) => ({ "@type": "Place", "name": a.name })),
  "sameAs": business.sameAs
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
