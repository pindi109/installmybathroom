---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import StickyMobileCTA from "../../components/StickyMobileCTA.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FAQ from "../../components/FAQ.astro";
import { business } from "../../config/business.ts";
import services from "../../data/services.json";

const faqs = [
  {
    q: "How far is Crowthorne from your Bracknell base?",
    a: "Around 10 minutes by road — close enough that it rarely adds anything to the programme, and we can usually fit in a short-notice survey or a snagging visit without a long wait.",
  },
  {
    q: "What kind of housing is typical in Crowthorne?",
    a: "A mix of substantial Victorian and Edwardian houses near the village centre and towards Wellington College, alongside twentieth-century family housing and some more recent infill. The older stock generally needs more careful checking of floor construction and plumbing age than the newer housing.",
  },
  {
    q: "Is planning permission needed for a bathroom refit in Crowthorne?",
    a: "A standard internal refit — new sanitaryware, retiling, updated electrics — doesn't normally need planning permission. Some of the larger period properties near the village centre may be listed or close to a conservation boundary, in which case work touching the external fabric can need separate consent, which we'll flag at survey.",
  },
  {
    q: "What water pressure should I expect in a Crowthorne property?",
    a: "It depends on the age of the house. Victorian and Edwardian properties sometimes still run on a gravity-fed system with a loft tank; more recent housing is typically mains pressure via a combi or cylinder. We measure actual pressure and flow at every survey before specifying a digital or thermostatic shower.",
  },
  {
    q: "Do large period houses near Wellington College need extra checks before a wet room?",
    a: "Often, yes. Many of the larger older properties in this part of Crowthorne have suspended timber ground floors rather than a solid slab, which affects deflection under tanking and large-format tiles. We check this at survey before specifying a wet room or heavy natural stone.",
  },
  {
    q: "How long does a typical Crowthorne bathroom installation take?",
    a: "A single bathroom strip-out and refit usually runs two to three weeks depending on scope, longer where natural stone, underfloor heating or a steam shower is specified, since those need drying and curing time built into the programme. We confirm a realistic timeline at survey once we've seen the room and the products involved.",
  },
  {
    q: "Can you coordinate with a wider refurbishment project in Crowthorne?",
    a: "Yes. Where a bathroom forms part of a larger renovation or extension, we're happy to work to someone else's programme and liaise directly with the builder, architect or project manager, sequencing our trades around the rest of the build.",
  },
];
---

<Base
  title="Bathroom Installation in Crowthorne | Install My Bathroom"
  description="Fit-only luxury bathroom installation in Crowthorne, Berkshire. Period and family homes, from £3,500. Around 10 minutes from Bracknell."
>
  <Header slot="header" />

  <section class="section-sm">
    <div class="container max-w-3xl">
      <Breadcrumbs items={[{ label: "Areas", href: "/areas/" }, { label: "Crowthorne", href: "/areas/crowthorne/" }]} />
      <h1 class="text-4xl font-bold mb-4 fade-up">Bathroom Installation in Crowthorne</h1>
      <p class="text-lg leading-relaxed mb-8 fade-up" style="color: var(--text-soft);">
        Crowthorne sits immediately next to Bracknell, a village best known for Wellington College and its surrounding streets of substantial Victorian and Edwardian housing. We travel in from our Bracknell base, a short journey of around 10 minutes, to install luxury bathrooms on a strict fit-only basis: you source the sanitaryware, brassware, tiles and furniture, we carry out strip-out, first fix, tanking, tiling and the final snag, from £{business.pricing.fromGBP.toLocaleString()}.
      </p>
      <div class="flex flex-wrap gap-4 fade-up">
        <a href="/survey/" class="btn-primary">Book a Survey — £{business.pricing.surveyGBP}</a>
        <a href={`tel:${business.phoneE164}`} class="btn-secondary">Call {business.phone}</a>
      </div>
    </div>
  </section>

  <!-- Local context -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Crowthorne's housing stock</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        Crowthorne's character comes partly from its association with Wellington College, and the roads around it carry a good number of substantial Victorian and Edwardian houses built for an earlier generation of staff and commuters. Further from the village centre there's more twentieth-century family housing and some newer infill on redeveloped plots. The older stock tends to have solid masonry walls and, on the ground floor at least, a higher chance of suspended timber construction than the newer housing — which matters for anyone specifying a wet room or large-format porcelain, since suspended floors need checking for deflection before tanking goes down.
      </p>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        Plumbing age follows a similar pattern. Some of the larger period houses have never had a full re-plumb and still run partly on a gravity-fed hot water system with a header tank in the loft, while others have been upgraded to mains pressure over the years. We measure actual pressure and flow at every survey rather than assuming, because it determines whether a digital or thermostatic shower will perform as the manufacturer's specification promises.
      </p>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        Plot sizes near Wellington College and the surrounding roads tend to be generous, which usually gives more flexibility with bathroom layout than a smaller plot allows — moving a waste run to accommodate a freestanding bath, for example, is rarely constrained by a neighbouring wall. Where that flexibility does run into a limit, it's usually the fall to an existing external drain run, which we check and re-route during first fix where needed.
      </p>
    </div>
  </section>

  <!-- Planning -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Listed buildings and conservation considerations</h2>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        A standard internal bathroom refit — new sanitaryware, retiling, updated electrics — does not normally require planning permission. Where it can matter in Crowthorne is on the larger period properties near the village centre, some of which are listed or sit within a conservation area; work affecting the external fabric, such as a new extraction vent through an original wall, can need separate consent. We'll flag this plainly at survey rather than assume it's fine, and point you to the local planning authority to confirm before anything is ordered.
      </p>
    </div>
  </section>

  <!-- What fit-only looks like -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">What a fit-only installation involves</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        Because you've bought the products independently, our first job at survey is checking what you've chosen against the room and against each other — waste positions, tap hole centres, support requirements for a wall-hung WC or vanity unit — before any wall is opened. That avoids discovering a mismatch once strip-out has already started.
      </p>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        On site we protect floors and stairs on the route in, keep the site clean at the end of every day, and agree parking and access with you before work starts. Being close to our Bracknell base means we can usually turn around a short-notice visit quickly if a delivery arrives early or a snag needs a quick revisit.
      </p>
    </div>
  </section>

  <!-- Services available -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-6 fade-up">Services available in Crowthorne</h2>
      <div class="grid md:grid-cols-2 gap-3">
        {services.slice(0, 10).map((s: { slug: string; name: string }) => (
          <a href={`/services/${s.slug}/`} class="card p-4 fade-up">
            <span class="font-medium text-sm">{s.name}</span>
          </a>
        ))}
      </div>
      <div class="mt-6 fade-up">
        <a href="/services/" class="font-semibold" style="color: var(--teal);">All services →</a>
      </div>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Nearby areas</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        We also install in neighbouring Sandhurst, our Bracknell base, and Binfield. If you're just outside Crowthorne's boundary, get in touch and we'll confirm coverage before you book a survey — the standards and checks we apply don't change from one village to the next.
      </p>
      <div class="flex flex-wrap gap-3 fade-up">
        <a href="/areas/sandhurst/" class="btn-secondary">Sandhurst</a>
        <a href="/areas/bracknell/" class="btn-secondary">Bracknell</a>
        <a href="/areas/binfield/" class="btn-secondary">Binfield</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-8 fade-up">Frequently asked questions</h2>
      <FAQ items={faqs} schemaId="crowthorne-faq" />
    </div>
  </section>

  <!-- Why fit-only -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Why choose a fit-only installer</h2>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        A design-and-build company marks up every product it supplies and works from a limited showroom range. Buying your own sanitaryware, brassware and tiles directly from specialist suppliers means you're not restricted to one company's stock, and you keep control of the budget on the most expensive line items yourself. What that model needs on the installation side is a team confident working to your specification and quick to flag a mismatch — a basin with the wrong waste size, a shower valve needing a different cable gland — before it becomes a costly delay. That's the approach we've built over 30 years of fit-only installation, and for a period Crowthorne property it often starts with a careful look at the floor and the plumbing before any product is even ordered.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-sm">
    <div class="container max-w-3xl text-center">
      <a href="/survey/" class="btn-primary">Book a Survey in Crowthorne</a>
    </div>
  </section>

  <Footer slot="footer" />
  <StickyMobileCTA slot="sticky-cta" />
</Base>
