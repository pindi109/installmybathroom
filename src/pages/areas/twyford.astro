---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import StickyMobileCTA from "../../components/StickyMobileCTA.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FAQ from "../../components/FAQ.astro";
import { business } from "../../config/business.ts";
import services from "../../data/services.json";

const faqs = [
  {
    q: "Do you cover Twyford even though it's further from Bracknell than some of your other areas?",
    a: "Yes, Twyford is within our regular working area, around 25 to 30 minutes from our Bracknell base — the extra distance doesn't change our pricing or the way we programme the job.",
  },
  {
    q: "What kind of homes do you typically fit bathrooms in around Twyford?",
    a: "A mix of older village housing in and around the centre of Twyford, and newer commuter-belt development on the edges of the village. We survey each property individually rather than assuming a single construction type.",
  },
  {
    q: "Do older Twyford properties need extra checks before a wet room or large-format tiling?",
    a: "Some do. Village-core properties can have suspended timber floors, which need checking for deflection before a wet room is tanked or large-format porcelain is laid. Newer housing on the village edges is more likely to have a solid slab that needs less preparation.",
  },
  {
    q: "Is planning permission needed for a bathroom refit in Twyford?",
    a: "A standard like-for-like internal refit doesn't normally need planning permission. It becomes relevant if the work affects the external fabric of the building, which is more likely on an older village property — we'll flag this at survey if it applies.",
  },
  {
    q: "What's the water pressure like in Twyford?",
    a: "It depends on the property — newer housing is generally on consistent mains pressure, while some older village properties may still have a gravity-fed system. We test actual pressure and flow at every survey before specifying a shower.",
  },
  {
    q: "How far is Twyford from your Bracknell base?",
    a: "Around 25 to 30 minutes by road, sitting between Reading and Maidenhead.",
  },
  {
    q: "Will you still survey a job in Twyford at the edge of your normal coverage area?",
    a: "Yes, Twyford is part of our regular coverage and we survey every property the same way regardless of distance, measuring the room, checking floor and wall construction, and testing water pressure before anything is priced.",
  },
  {
    q: "What does the installation itself involve once it starts in Twyford?",
    a: "Strip-out, first-fix plumbing and electrics, tanking where required, tiling, and final fix and snagging, with floors and staircases protected throughout and the work area kept tidy and contained each day.",
  },
  {
    q: "Can you fit an en-suite into a Twyford property that doesn't currently have one?",
    a: "Often, yes, subject to checking the existing soil stack and waste runs at survey. Village-core cottages sometimes need creative routing to avoid opening up a floor unnecessarily, while newer commuter-belt housing is usually more straightforward to extend.",
  },
  {
    q: "Do you supply the bathroom products yourselves in Twyford, or only fit them?",
    a: "We're fit-only — you buy the sanitaryware, brassware, tiles and furniture from the retailer or showroom of your choice, and we install them. We'll tell you clearly at survey what dimensions and fixing requirements to check before you order.",
  },
  {
    q: "Can you fit underfloor heating in a Twyford bathroom?",
    a: "Yes, both electric and water-based systems, depending on your existing heating setup and the floor construction. We confirm which is suitable for your property and room at survey, before your flooring or tiles are ordered.",
  },
];
---

<Base
  title="Bathroom Installation in Twyford | Install My Bathroom"
  description="Fit-only luxury bathroom installation in Twyford, Berkshire. Village and commuter-belt homes, from £3,500. 25-30 minutes from Bracknell."
>
  <Header slot="header" />

  <section class="section-sm">
    <div class="container max-w-3xl">
      <Breadcrumbs items={[{ label: "Areas", href: "/areas/" }, { label: "Twyford", href: "/areas/twyford/" }]} />
      <h1 class="text-4xl font-bold mb-4 fade-up">Bathroom Installation in Twyford</h1>
      <p class="text-lg leading-relaxed mb-8 fade-up" style="color: var(--text-soft);">
        We fit luxury, client-supplied bathrooms in Twyford, the Berkshire village between Reading and Maidenhead, around 25 to 30 minutes from our Bracknell base. You source the sanitaryware, brassware and tiles; we handle the strip-out, first fix, tiling and final fit, from £{business.pricing.fromGBP.toLocaleString()}. We survey every property individually before quoting, since the village's mix of older cottages and newer commuter housing calls for genuinely different approaches to the same job.
      </p>
      <div class="flex flex-wrap gap-4 fade-up">
        <a href="/survey/" class="btn-primary">Book a Survey — £{business.pricing.surveyGBP}</a>
        <a href={`tel:${business.phoneE164}`} class="btn-secondary">Call {business.phone}</a>
      </div>
    </div>
  </section>

  <!-- Local context -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Twyford's housing stock</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        Twyford sits on the railway line between Reading and Maidenhead, which has shaped its growth over the years — an older village centre with period cottages and terraces, surrounded by commuter-belt housing built up in waves as the village became more popular with people working towards London. That mix means we see both compact, older floor plans with narrower bathrooms to work within, and larger, more recently built houses where there's more flexibility on layout.
      </p>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        Floor construction follows the same pattern. Period properties in and around the village centre are more likely to have suspended timber floors, which we check for deflection before specifying large-format porcelain or a tanked wet room. Housing from more recent decades on the edges of the village generally sits on a solid concrete slab, which usually needs less preparation before tiling.
      </p>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        Layout and room size follow the village's two building eras fairly closely. Period cottages and terraces in the centre of Twyford often have a single, compact bathroom with limited scope to move waste pipework without opening up the floor structure; newer commuter-belt housing on the edges of the village more often has both a family bathroom and an en-suite, with more flexibility over fixture positions. We confirm what's achievable in your specific room at survey rather than assuming it from the style of the house.
      </p>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        Water systems are also worth checking rather than assuming. Some older properties can still run partly on a gravity-fed hot water circuit even where the mains supply itself is strong, which affects how a digital or thermostatic shower performs if it isn't accounted for. We measure pressure and flow at every survey before any shower is specified.
      </p>
    </div>
  </section>

  <!-- What's included -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">What a fit-only installation involves in Twyford</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        You buy the sanitaryware, brassware and tiles from the supplier of your choice; we work from the exact specification of those products, confirming dimensions and fixing centres before anything is delivered to site. That matters as much in a compact village-centre cottage, where every centimetre of a small bathroom counts, as it does on a larger commuter-belt house with more room to work with.
      </p>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        On site, the job runs through strip-out, first-fix plumbing and electrics, tanking where required, tiling, and final fix and snagging. We protect flooring and stairs for the duration of the work, agree parking and access in advance where village streets are narrow, and leave the property clean and tidy at the end of each day.
      </p>
    </div>
  </section>

  <!-- Planning -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Planning and conservation considerations</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        A standard internal bathroom refit doesn't normally require planning permission. It can become relevant on some of the older properties around Twyford's village centre if work affects the external fabric of the building — a new extraction vent through an outer wall, for example. If that applies to your property, we'll flag it at survey and point you to the local planning authority to confirm before anything is ordered.
      </p>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        Where a bathroom is part of a wider loft or rear extension project rather than a like-for-like refit, Building Regulations approval covering drainage, ventilation and electrical safety will usually apply regardless of whether planning permission is needed. We'll say so plainly if that applies to your project.
      </p>
    </div>
  </section>

  <!-- Services available -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-6 fade-up">Services available in Twyford</h2>
      <div class="grid md:grid-cols-2 gap-3">
        {services.slice(0, 10).map((s: { slug: string; name: string }) => (
          <a href={`/services/${s.slug}/`} class="card p-4 fade-up">
            <span class="font-medium text-sm">{s.name}</span>
          </a>
        ))}
      </div>
      <div class="mt-6 fade-up">
        <a href="/services/" class="font-semibold" style="color: var(--teal);">All services →</a>
      </div>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Nearby areas</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        We also install in neighbouring Reading, home to the University of Reading, as well as Maidenhead on the Thames and the market town of Wokingham — all a broadly similar distance from our Bracknell base.
      </p>
      <div class="flex flex-wrap gap-3 fade-up">
        <a href="/areas/reading/" class="btn-secondary">Reading</a>
        <a href="/areas/maidenhead/" class="btn-secondary">Maidenhead</a>
        <a href="/areas/wokingham/" class="btn-secondary">Wokingham</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-8 fade-up">Frequently asked questions</h2>
      <FAQ items={faqs} schemaId="twyford-faq" />
    </div>
  </section>

  <!-- CTA -->
  <section class="section-sm">
    <div class="container max-w-3xl text-center">
      <p class="leading-relaxed mb-6" style="color: var(--text-soft);">
        A £{business.pricing.surveyGBP} survey gets a qualified installer out to your Twyford property to measure the room, check floor and wall construction, test water pressure and talk through what your chosen products need for a correct installation. You'll leave with an itemised quote and a realistic programme before ordering anything, and a clear answer on anything that needs checking before you buy.
      </p>
      <a href="/survey/" class="btn-primary">Book a Survey in Twyford</a>
    </div>
  </section>

  <Footer slot="footer" />
  <StickyMobileCTA slot="sticky-cta" />
</Base>
