---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import StickyMobileCTA from "../../components/StickyMobileCTA.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FAQ from "../../components/FAQ.astro";
import { business } from "../../config/business.ts";
import services from "../../data/services.json";

const faqs = [
  {
    q: "How far is Winkfield from your Bracknell base?",
    a: "Around 5 to 15 minutes by road, depending on which part of the parish you're in — close enough that access and short-notice visits rarely add to the programme.",
  },
  {
    q: "What kind of housing is typical in Winkfield?",
    a: "A mix of older village-core cottages and farmhouses, alongside newer housing on the edges of the parish towards Bracknell and Ascot. We treat the two quite differently at survey — older buildings generally need more careful checking of floor construction and plumbing age.",
  },
  {
    q: "Is planning permission needed for a bathroom refit in Winkfield?",
    a: "A standard internal refit — new sanitaryware, retiling, updated electrics — doesn't normally need planning permission. Some of the older buildings near the village core may be listed or close to a conservation boundary, in which case work touching the external fabric can need separate consent, which we'll flag at survey.",
  },
  {
    q: "What water pressure can I expect in a Winkfield property?",
    a: "It depends on the age and plumbing history of the house. Newer housing is typically mains pressure via a combi or cylinder; some older properties still run on a gravity-fed system with a loft tank. We measure actual pressure and flow at every survey before specifying a shower.",
  },
  {
    q: "Do you cover properties near Ascot Racecourse as well as the village itself?",
    a: "Yes — Winkfield sits right next to Ascot, and we cover the full parish, including properties close to the racecourse and the surrounding equestrian land.",
  },
  {
    q: "Can you install a wet room in an older Winkfield property?",
    a: "Usually yes, subject to checking the floor construction at survey. Many older buildings in this part of the parish have suspended timber floors rather than a solid slab, which affects how a wet room is tanked and supported, sometimes needing additional noggins or overboarding first.",
  },
  {
    q: "How long does a typical bathroom installation take in Winkfield?",
    a: "A single bathroom strip-out and refit usually runs two to three weeks depending on scope, longer where natural stone, underfloor heating or a steam shower is specified, since those need drying and curing time built into the programme.",
  },
];
---

<Base
  title="Bathroom Installation in Winkfield | Install My Bathroom"
  description="Fit-only luxury bathroom installation in Winkfield, Berkshire. Period and newer homes, from £3,500. 5-15 minutes from our Bracknell base."
>
  <Header slot="header" />

  <section class="section-sm">
    <div class="container max-w-3xl">
      <Breadcrumbs items={[{ label: "Areas", href: "/areas/" }, { label: "Winkfield", href: "/areas/winkfield/" }]} />
      <h1 class="text-4xl font-bold mb-4 fade-up">Bathroom Installation in Winkfield</h1>
      <p class="text-lg leading-relaxed mb-8 fade-up" style="color: var(--text-soft);">
        Winkfield sits just outside Bracknell on the way towards Ascot, a parish of older village housing and newer development close enough to our base that access and scheduling are rarely a constraint. We fit luxury bathrooms here on a strict fit-only basis: you source the sanitaryware, brassware, tiles and furniture, we handle strip-out, first fix, tanking, tiling and the final snag, from £{business.pricing.fromGBP.toLocaleString()}.
      </p>
      <div class="flex flex-wrap gap-4 fade-up">
        <a href="/survey/" class="btn-primary">Book a Survey — £{business.pricing.surveyGBP}</a>
        <a href={`tel:${business.phoneE164}`} class="btn-secondary">Call {business.phone}</a>
      </div>
    </div>
  </section>

  <!-- Local context -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Winkfield's housing stock</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        Winkfield's older centre still has a number of cottages and larger period houses, many associated historically with the surrounding farmland and the equestrian land towards Ascot, while the newer parts of the parish — closer to Bracknell and along the main roads — carry more recent estate-style housing. The two building types need different handling at survey: period buildings often have solid masonry walls and suspended timber floors that need checking for deflection before tanking or large-format tiling, while newer housing generally sits on a solid concrete slab that's more straightforward to work with.
      </p>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        Water pressure varies for similar reasons. Older properties sometimes still run partly on a gravity-fed hot water system with a header tank in the loft, while newer housing is typically mains pressure through a combi boiler or pressurised cylinder. We measure actual pressure and flow at every survey rather than assuming either, since it directly affects whether a digital or thermostatic shower performs as specified.
      </p>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        Plot sizes in the older part of Winkfield tend to be generous, reflecting the parish's rural and equestrian character, which usually gives more flexibility with layout than a smaller suburban plot would allow — moving a waste run to accommodate a freestanding bath, for example, is rarely constrained by a neighbouring wall. Where that flexibility does run into a limit is usually the fall to an existing external drain, which we check and, where necessary, re-route during first fix.
      </p>
    </div>
  </section>

  <!-- Planning -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Listed buildings and conservation considerations</h2>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        A standard internal bathroom refit — new sanitaryware, retiling, updated electrics — doesn't normally need planning permission. Where it can matter in Winkfield is on the older buildings near the village core, some of which are listed or sit close to a conservation boundary; work that affects the external fabric, such as a new extraction vent or a rooflight, can need separate consent. We'll flag this plainly at survey if it looks relevant, and point you to the local planning authority to confirm before anything is ordered. This is one of the questions we'd rather raise before you've ordered any products than after a wall has already been opened up.
      </p>
    </div>
  </section>

  <!-- Services available -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-6 fade-up">Services available in Winkfield</h2>
      <div class="grid md:grid-cols-2 gap-3">
        {services.slice(0, 10).map((s: { slug: string; name: string }) => (
          <a href={`/services/${s.slug}/`} class="card p-4 fade-up">
            <span class="font-medium text-sm">{s.name}</span>
          </a>
        ))}
      </div>
      <div class="mt-6 fade-up">
        <a href="/services/" class="font-semibold" style="color: var(--teal);">All services →</a>
      </div>
    </div>
  </section>

  <!-- What fit-only looks like -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">What a fit-only installation involves</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        Since you've bought the products yourself, our first task at survey is checking what you've chosen against the room and against each other — waste positions, tap hole centres, support requirements for a wall-hung WC or vanity unit — before any wall is opened. That avoids the common and expensive problem of discovering a mismatch once strip-out has started.
      </p>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        On site we protect floors and stairs on the route in, keep the site clean at the end of each day, and agree parking and access with you in advance — straightforward on most of Winkfield's residential roads, and something we check ahead of time for the narrower lanes near the older village centre. Being this close to our Bracknell base also means we can usually turn around a short-notice visit quickly if a delivery arrives early or a snag needs a quick revisit. For properties set back on longer private drives or shared equestrian access tracks, let us know at enquiry stage so we can plan vehicle access before the first day on site.
      </p>
    </div>
  </section>

  <!-- Why fit-only -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Why choose a fit-only installer</h2>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        A design-and-build company marks up every product it supplies and works from a limited showroom range. Buying your own sanitaryware, brassware and tiles directly from specialist suppliers means you're not restricted to one company's stock, and you keep control of the budget on the most expensive line items yourself. What that model needs on the installation side is a team confident working to your specification and quick to flag a mismatch — a basin with the wrong waste size, a shower valve needing a different cable gland — before it becomes a costly delay. That's the approach we've built over 30 years of fit-only installation.
      </p>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Nearby areas</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        We also install in neighbouring Ascot, Windsor and our Bracknell base. If you're just outside Winkfield's boundary, get in touch and we'll confirm coverage before you book a survey — the checks we carry out and the standards we work to don't change from one village to the next.
      </p>
      <div class="flex flex-wrap gap-3 fade-up">
        <a href="/areas/ascot/" class="btn-secondary">Ascot</a>
        <a href="/areas/windsor/" class="btn-secondary">Windsor</a>
        <a href="/areas/bracknell/" class="btn-secondary">Bracknell</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-8 fade-up">Frequently asked questions</h2>
      <FAQ items={faqs} schemaId="winkfield-faq" />
    </div>
  </section>

  <!-- CTA -->
  <section class="section-sm">
    <div class="container max-w-3xl text-center">
      <a href="/survey/" class="btn-primary">Book a Survey in Winkfield</a>
    </div>
  </section>

  <Footer slot="footer" />
  <StickyMobileCTA slot="sticky-cta" />
</Base>
