---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import StickyMobileCTA from "../../components/StickyMobileCTA.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import areasData from "../../data/areas.json";

const priorityOrder = new Map(areasData.priority.map((a: { slug: string }, i: number) => [a.slug, i]));
const priority = [...areasData.priority].sort((a: { slug: string }, b: { slug: string }) => priorityOrder.get(a.slug)! - priorityOrder.get(b.slug)!);
const prioritySlugs = new Set(priority.map((a: { slug: string }) => a.slug));
const allAreas = [...areasData.tier1, ...areasData.tier2];
const other = allAreas.filter((a: { slug: string }) => !prioritySlugs.has(a.slug));
---

<Base
  title="Areas We Cover | Install My Bathroom"
  description="Fit-only bathroom installation across Wentworth Estate, Virginia Water, Sunningdale, Ascot, Windsor and the surrounding Berkshire, Buckinghamshire and Surrey towns."
>
  <Header slot="header" />

  <section class="section-sm">
    <div class="container max-w-3xl">
      <Breadcrumbs items={[{ label: "Areas", href: "/areas/" }]} />
      <h1 class="text-4xl font-bold mb-4 fade-up">Areas We Cover</h1>
      <p class="text-lg leading-relaxed mb-4 fade-up" style="color: var(--text-soft);">
        Based in Bracknell, installing luxury bathrooms across Berkshire, Buckinghamshire and into Surrey.
      </p>
      <p class="leading-relaxed mb-8 fade-up" style="color: var(--text-soft);">
        The towns below are ordered by where we see the most sustained demand for high-end, fit-only bathroom installation — areas with a high concentration of large detached and period homes suited to a full re-fit, natural stone or bespoke brassware. "Also covered" towns get exactly the same standard of work; they simply see fewer enquiries of this type. If your town isn't listed at all, get in touch — we regularly travel further afield for the right project.
      </p>
    </div>
  </section>

  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container">
      <h2 class="text-xl font-bold mb-4 fade-up">Priority areas</h2>
      <div class="grid md:grid-cols-4 gap-4 mb-10">
        {priority.map((a: { slug: string; name: string; rank: number }) => (
          <a href={`/areas/${a.slug}/`} class="card p-5 text-center hover:-translate-y-1 transition-transform fade-up relative">
            <span class="absolute top-2 left-2 text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center text-white" style="background: var(--teal);">{a.rank}</span>
            <span class="font-semibold">{a.name}</span>
          </a>
        ))}
      </div>
      <h2 class="text-xl font-bold mb-4 fade-up">Also covered</h2>
      <div class="grid md:grid-cols-4 gap-4">
        {other.map((a: { slug: string; name: string }) => (
          <a href={`/areas/${a.slug}/`} class="card p-5 text-center hover:-translate-y-1 transition-transform fade-up">
            <span class="font-semibold">{a.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <StickyMobileCTA slot="sticky-cta" />
</Base>
