---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import StickyMobileCTA from "../../components/StickyMobileCTA.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FAQ from "../../components/FAQ.astro";
import { business } from "../../config/business.ts";
import services from "../../data/services.json";

const faqs = [
  {
    q: "How far is Gerrards Cross from your Bracknell base?",
    a: "Around 25 to 30 minutes by road. We treat this as routine travel and factor it into scheduling, so it has no bearing on programme length or how we sequence deliveries and trades on site. It also means we can get back on site quickly if a delivery arrives early or a snag needs a same-week revisit.",
  },
  {
    q: "Do you work on gated or private roads in Gerrards Cross?",
    a: "Yes. A number of properties sit behind electric gates or on private managed roads with their own access arrangements. Tell us at enquiry stage so we can arrange access codes, a fob, or a managing agent introduction ahead of the first visit, which avoids any delay to the start date.",
  },
  {
    q: "Will a bathroom refit in Gerrards Cross need planning permission?",
    a: "A like-for-like internal refit — new sanitaryware, tiling, updated electrics — usually doesn't. If the property is in a conservation area or the work affects the external wall, such as a new extraction vent or a rooflight into a loft en-suite, separate consent can apply. We'll flag this plainly at survey rather than assume it's fine.",
  },
  {
    q: "What water pressure can I expect in a Gerrards Cross property?",
    a: "It depends on the age of the house and whether it's still running on an older gravity-fed system with a loft tank, or has since been converted to mains pressure. We test actual pressure and flow at survey before specifying any digital, thermostatic or rainfall shower, rather than relying on the manufacturer's assumed figures.",
  },
  {
    q: "Can you install a wet room in a 1930s Gerrards Cross house?",
    a: "Generally yes, subject to checking the floor structure at survey. Many homes of this era have suspended timber floors rather than a solid slab, which affects how we tank and support a level-access wet room floor — sometimes requiring additional noggins or a structural joist check before the membrane goes down.",
  },
  {
    q: "Do you coordinate with architects or project managers on larger Gerrards Cross rebuilds?",
    a: "Yes. Where a bathroom forms part of a wider refurbishment or new-build project, we're happy to work to someone else's programme and liaise directly with the architect, main contractor or project manager, fitting our sequence around the rest of the build rather than imposing our own.",
  },
  {
    q: "Can you match an installation to products bought from more than one supplier?",
    a: "Yes, this is the norm rather than the exception. Most of our Gerrards Cross clients buy sanitaryware, brassware and tiles from different specialist suppliers to get the exact combination they want. We check compatibility of waste sizes, tap centres and fixing requirements across all of them before strip-out starts.",
  },
  {
    q: "Do you offer a survey before I've finalised my product choices?",
    a: "We can, though it's usually more useful once you have at least a shortlist, so we can check dimensions and specifications against the room. Our £125 survey covers the existing plumbing, electrics, floor structure and water pressure, and flags anything that needs resolving before products are ordered.",
  },
  {
    q: "How long does a typical Gerrards Cross bathroom installation take?",
    a: "A single bathroom strip-out and refit usually runs two to three weeks depending on scope — longer where natural stone, a steam shower or underfloor heating is specified, since those trades need drying and curing time built into the programme. We confirm a realistic timeline at survey once we've seen the room and the products involved.",
  },
];
---

<Base
  title="Gerrards Cross Bathroom Installation | Install My Bathroom"
  description="Fit-only luxury bathroom installation in Gerrards Cross, Buckinghamshire. Client-supplied bathrooms, from £3,500. Around 25-30 min from Bracknell."
>
  <Header slot="header" />

  <section class="section-sm">
    <div class="container max-w-3xl">
      <Breadcrumbs items={[{ label: "Areas", href: "/areas/" }, { label: "Gerrards Cross", href: "/areas/gerrards-cross/" }]} />
      <h1 class="text-4xl font-bold mb-4 fade-up">Bathroom Installation in Gerrards Cross</h1>
      <p class="text-lg leading-relaxed mb-8 fade-up" style="color: var(--text-soft);">
        We install luxury, fit-only bathrooms for homeowners across Gerrards Cross, the affluent Buckinghamshire commuter village close to Beaconsfield and Chalfont St Peter, around 25 to 30 minutes by road from our Bracknell base. You source the sanitaryware, brassware, tiles and furniture; we strip out, first-fix, tile, plumb and snag, from £{business.pricing.fromGBP.toLocaleString()}.
      </p>
      <div class="flex flex-wrap gap-4 fade-up">
        <a href="/survey/" class="btn-primary">Book a Survey — £{business.pricing.surveyGBP}</a>
        <a href={`tel:${business.phoneE164}`} class="btn-secondary">Call {business.phone}</a>
      </div>
    </div>
  </section>

  <!-- Local context -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl grid md:grid-cols-[1fr_280px] gap-8 items-start">
      <div>
        <h2 class="text-2xl font-bold mb-4 fade-up">What we find inside Gerrards Cross homes</h2>
        <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
          Gerrards Cross sits firmly in the commuter belt that runs along the Chiltern fringe, and its housing reflects that: substantial inter-war detached houses on tree-lined roads, a good number of 1950s and 1960s family homes, and — on the larger, older plots — contemporary architect-designed rebuilds that have replaced an original house entirely. Each of those three building types behaves differently once you start opening up a bathroom, and we treat them differently at survey rather than applying one standard spec.
        </p>
        <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
          The inter-war and 1950s stock most often has solid masonry walls and, on the ground floor at least, a mix of solid and suspended timber construction depending on when any extension was added. Suspended timber floors need checking for deflection before large-format porcelain or a tanked wet room goes down — too much movement under tile and you get cracked grout lines or, worse, a failed membrane at a joint. We measure this at survey and, where needed, specify additional noggins or a rigid tile backer board rather than tiling straight onto joists and boards.
        </p>
        <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
          Newer rebuilds on these plots are usually built to current Building Regulations, with solid concrete floors throughout and modern first-fix plumbing already in a sensible layout — which generally makes for a more straightforward containment and waste run, even where the finished specification (natural stone, a steam shower, a freestanding bath on a cantilevered support) is considerably more ambitious than the original house.
        </p>
        <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
          Water pressure varies more than most homeowners expect for an area with this concentration of high-value property. Some houses have been fully converted to mains-fed, unvented hot water; others, particularly where a loft conversion or extension has never prompted a full re-plumb, still run on a gravity-fed system with a header tank. We test actual pressure and flow during the survey rather than assuming either, because it determines whether a digital or thermostatic shower will perform as the manufacturer's specification promises — or whether a pump needs adding first.
        </p>
        <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
          Plot sizes in Gerrards Cross also tend to be generous, which gives more freedom with layout than a terraced property would allow. Moving a waste run to accommodate a freestanding bath, or relocating a WC to open up space for a double vanity, is rarely constrained by a neighbouring wall or a shared soil stack in the way it would be on a smaller plot. Where that flexibility does run into a limit is usually the fall to an existing external drain run, which we check and, if necessary, re-route during first-fix rather than compromise on layout.
        </p>
        <p class="leading-relaxed" style="color: var(--text-soft);">
          We also see a fair number of loft conversions and rear extensions in this part of Buckinghamshire, which often bring a request to add a new en-suite or move an existing family bathroom to make better use of the extra floor area. These projects usually mean extending plumbing runs further than the original house was designed for, and sometimes adding a macerator or a small pump where gravity alone won't get waste to the stack. We size and route this at survey, factoring in noise — a loft en-suite directly above a bedroom needs a quieter pump and better sound insulation under the floor than one above a landing.
        </p>
      </div>
      <div class="card overflow-hidden fade-up hidden md:block">
        <img src="/assets/inline/gerrards-cross-contemporary-ensuite.webp" alt="Contemporary en-suite bathroom with large-format porcelain tiling and brushed brass fittings in a Gerrards Cross rebuild" width="800" height="600" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
      </div>
    </div>
  </section>

  <!-- Planning -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Conservation areas and external works</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        A standard internal bathroom refit — new sanitaryware, retiling, updated lighting and extraction — does not usually need planning permission. Where it can matter in Gerrards Cross is where the property falls within a designated conservation area, or where the work touches the external fabric of the building: a new mechanical extraction vent cut through an original wall, or a rooflight added to bring daylight into a converted loft en-suite, are the kinds of changes that sometimes need separate consent. We'll flag this plainly at survey if we think it applies, and point you to the local planning authority to confirm before anything is ordered.
      </p>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        For anyone planning a bathroom as part of a wider project in a listed or sensitive property, our guide to <a href="/guides/bathroom-renovation-in-listed-and-conservation-properties/" style="color: var(--teal); font-weight: 600;">bathroom renovation in listed and conservation properties</a> sets out the questions worth asking before you commit to a layout.
      </p>
    </div>
  </section>

  <!-- What a fit-only installation involves -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl grid md:grid-cols-[1fr_280px] gap-8 items-start">
      <div>
        <h2 class="text-2xl font-bold mb-4 fade-up">How a fit-only installation runs in Gerrards Cross</h2>
        <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
          Because you've already bought the sanitaryware, brassware and tiles, our first job at survey is to check what's arrived against the manufacturer's installation requirements — waste positions, tap hole centres, support weight for a wall-hung WC or vanity unit — before a single wall is opened. That avoids the common and expensive problem of discovering a mismatch once strip-out has started.
        </p>
        <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
          From there the sequence is strip-out and first-fix plumbing and electrics, tanking where a wet room or shower area needs it, then tiling set out from a centre line so joints run through consistently from floor to wall, followed by second-fix sanitaryware, brassware and final snagging. We protect floors and stairwells throughout, keep the site clean at the end of each day, and work to the programme agreed at survey.
        </p>
        <p class="leading-relaxed" style="color: var(--text-soft);">
          Many of the houses we work on in Gerrards Cross are occupied throughout the project, sometimes with the owners still coming and going between rooms that aren't part of the works. We sheet and board protected routes through hallways and up staircases on day one, agree parking for the van with you in advance where a gated drive or a shared private road is involved, and keep noisy work — breaking out an old shower tray, for example — to sensible hours. Where a property is let, we coordinate dates directly with the managing agent so access is arranged before the team arrives.
        </p>
      </div>
      <div class="card overflow-hidden fade-up hidden md:block">
        <img src="/assets/inline/gerrards-cross-timber-floor-noggins.webp" alt="Installer fixing timber noggins between exposed floor joists to strengthen a suspended timber floor before tanking" width="800" height="600" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
      </div>
    </div>
  </section>

  <!-- Why fit-only -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Why Gerrards Cross homeowners choose a fit-only installer</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        A design-and-build company will usually mark up every product it supplies, and its showroom range — however well presented — is still a limited selection. Buying your own sanitaryware, brassware and tiles directly from specialist suppliers or showrooms means you're not restricted to what one company stocks, and you keep control of the budget on the most expensive line items yourself.
      </p>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        What that approach needs on the installation side is a team that's comfortable working to someone else's product specification rather than its own, and confident enough to flag a problem — a tap with the wrong reach for a basin, a shower valve that needs a different cable gland — before it becomes an expensive mid-project change. That's the model we've built our business on for 30 years, and it's why most of our Gerrards Cross clients come to us already holding a shortlist, or an order confirmation, rather than a blank page.
      </p>
    </div>
  </section>

  <!-- Services available -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-6 fade-up">Services available in Gerrards Cross</h2>
      <p class="leading-relaxed mb-6" style="color: var(--text-soft);">
        We cover the full range of fit-only bathroom work in Gerrards Cross, from a straightforward cloakroom refit through to a wet room, steam shower or natural stone installation spanning several rooms, and the plumbing, electrical and tiling trades that sit behind each of those finishes.
      </p>
      <div class="grid md:grid-cols-2 gap-3">
        {services.slice(0, 12).map((s: { slug: string; name: string }) => (
          <a href={`/services/${s.slug}/`} class="card p-4 fade-up">
            <span class="font-medium text-sm">{s.name}</span>
          </a>
        ))}
      </div>
      <div class="mt-6 fade-up">
        <a href="/services/" class="font-semibold" style="color: var(--teal);">All services →</a>
      </div>
    </div>
  </section>

  <!-- Typical projects -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">The kind of projects we fit in Gerrards Cross</h2>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        The enquiries we get from this area tend to fall into a few recognisable categories: a principal en-suite being upgraded from a dated three-piece suite to a walk-in shower, concealed cistern and double vanity; a loft or garden-level conversion that needs a new bathroom built into a space that didn't have one before; and whole-house refurbishments where every bathroom is replaced in sequence, often while the family is still living in part of the house. Natural stone and large-format porcelain come up regularly, as do freestanding baths and wall-hung shower toilets, reflecting the scale of the properties and the budgets available to specify them properly. Whatever the brief, the survey and the installation discipline are the same — set-out from a true centre line, tanking to a recognised standard, and tap and waste positions checked against the actual products before anything is cut.
      </p>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Nearby areas</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        We also install bathrooms in neighbouring villages and towns, including Stoke Poges, Windsor and our Bracknell base, and we're happy to discuss projects just outside these pages too — the fit-only approach and the checks we carry out at survey don't change from one postcode to the next.
      </p>
      <div class="flex flex-wrap gap-3 fade-up">
        <a href="/areas/stoke-poges/" class="btn-secondary">Stoke Poges</a>
        <a href="/areas/windsor/" class="btn-secondary">Windsor</a>
        <a href="/areas/bracknell/" class="btn-secondary">Bracknell</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-8 fade-up">Frequently asked questions</h2>
      <FAQ items={faqs} schemaId="gerrards-cross-faq" />
    </div>
  </section>

  <!-- CTA -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl text-center">
      <a href="/survey/" class="btn-primary">Book a Survey in Gerrards Cross</a>
    </div>
  </section>

  <Footer slot="footer" />
  <StickyMobileCTA slot="sticky-cta" />
</Base>
