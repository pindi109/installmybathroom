---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import StickyMobileCTA from "../../components/StickyMobileCTA.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FAQ from "../../components/FAQ.astro";
import { business } from "../../config/business.ts";
import services from "../../data/services.json";

const faqs = [
  {
    q: "What kind of properties do you typically fit bathrooms in around Wokingham?",
    a: "A genuine mix — period townhouses and villas close to the historic town centre, inter-war and post-war semis and detached houses in the surrounding suburbs, and more recent estate development on the edges of the town. We survey each property on its own terms rather than pricing from a template.",
  },
  {
    q: "Do older Wokingham properties need extra checks before a wet room or large-format tiling?",
    a: "Often, yes. Period properties near the town centre can have suspended timber floors, which need checking for deflection before a wet room is tanked or large-format porcelain is laid. We assess floor construction at every survey and specify boarding or battening where it's needed.",
  },
  {
    q: "Is planning permission needed for a bathroom refit in Wokingham?",
    a: "A standard like-for-like internal refit — new suite, retiling, updated electrics — doesn't normally need planning permission. It can matter if your property is listed, sits within the town's conservation area, or if work affects the external fabric of the building, such as a new extraction vent. We'll flag this at survey if it applies.",
  },
  {
    q: "What's the water pressure like in Wokingham?",
    a: "It varies with the age and type of property — newer estate housing is usually on strong, consistent mains pressure, while some older town-centre and village-edge properties may still run partly on a gravity-fed system with a loft tank. We test actual pressure and flow at every survey before specifying a shower.",
  },
  {
    q: "How far is Wokingham from your Bracknell base?",
    a: "Around 15 to 20 minutes by road, which keeps deliveries and site visits straightforward throughout the installation.",
  },
  {
    q: "Can you fit more than one bathroom on the same visit in Wokingham?",
    a: "Yes, we regularly programme a main bathroom, en-suite and cloakroom as a single coordinated job, sequencing wet and dry trades so the whole house isn't out of action at once.",
  },
  {
    q: "Do you supply the bathroom products, or only fit them, in Wokingham?",
    a: "We're fit-only — you buy the sanitaryware, brassware, tiles and furniture from the retailer or showroom of your choice, and we handle the installation. We'll confirm at survey exactly what dimensions and fixing requirements to check before you order.",
  },
  {
    q: "Can you fit a shower toilet or bidet in a Wokingham bathroom?",
    a: "Yes, including concealed-cistern shower toilets, which need a dedicated electrical supply run to the correct point behind the pan. We plan this in at first fix once your chosen model is confirmed.",
  },
];
---

<Base
  title="Bathroom Installation in Wokingham | Install My Bathroom"
  description="Fit-only luxury bathroom installation in Wokingham, Berkshire. Period and estate homes, from £3,500. Around 15-20 minutes from Bracknell."
>
  <Header slot="header" />

  <section class="section-sm">
    <div class="container max-w-3xl">
      <Breadcrumbs items={[{ label: "Areas", href: "/areas/" }, { label: "Wokingham", href: "/areas/wokingham/" }]} />
      <h1 class="text-4xl font-bold mb-4 fade-up">Bathroom Installation in Wokingham</h1>
      <p class="text-lg leading-relaxed mb-8 fade-up" style="color: var(--text-soft);">
        We fit luxury, client-supplied bathrooms across Wokingham, the Berkshire market town around 15 to 20 minutes from our Bracknell base. You buy the sanitaryware, brassware and tiles; we carry out the strip-out, first fix, tiling and final fit, from £{business.pricing.fromGBP.toLocaleString()}. Every job is priced from a survey of your actual room and property, whether that's a single cloakroom refresh or a full house of bathrooms.
      </p>
      <div class="flex flex-wrap gap-4 fade-up">
        <a href="/survey/" class="btn-primary">Book a Survey — £{business.pricing.surveyGBP}</a>
        <a href={`tel:${business.phoneE164}`} class="btn-secondary">Call {business.phone}</a>
      </div>
    </div>
  </section>

  <!-- Local context -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl grid md:grid-cols-[1fr_280px] gap-8 items-start">
      <div>
      <h2 class="text-2xl font-bold mb-4 fade-up">Wokingham's housing stock</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        Wokingham's historic core — around the market place and the streets leading off it — holds a good number of Georgian and Victorian townhouses and villas, many later divided or extended as the town grew. Beyond that centre, the town has expanded substantially through inter-war, post-war and contemporary estate development, so a typical week for us might include a Victorian villa conversion, a 1950s detached house, and a bathroom in a new-build estate home on the same road. We treat each as its own job rather than assuming a standard layout from the postcode.
      </p>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        That spread of building ages means floor and wall construction varies more than in a town built in a single era. Properties near the historic centre are more likely to have suspended timber ground floors, which we check for deflection before specifying large-format porcelain or a tanked wet room; newer estate housing generally sits on a solid concrete slab that takes tiling with less preparation. Partition walls follow a similar pattern — older lath-and-plaster or solid masonry internal walls need different fixings to modern plasterboard stud when it comes to a wall-hung WC frame or a heavy stone vanity top.
      </p>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        Bathroom layouts also vary with the building era. A period townhouse near the centre may have a single bathroom converted from a bedroom decades ago, with limited scope to reroute the soil pipe without disturbing the floor below; a 1930s or post-war detached house often has a more generously proportioned original bathroom that gives more room to reconfigure; newer estate housing typically comes with both an en-suite and a family bathroom built to a fairly standard layout. We confirm what's achievable for your specific room at survey.
      </p>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        Water pressure tracks the same split. Newer estate housing is usually on strong, consistent mains pressure throughout, which suits digital and thermostatic showers without complication. Some of the older town-centre properties can still have a gravity-fed hot water circuit from a loft tank, even where the cold mains itself is perfectly strong — we measure actual pressure and flow at every survey rather than assuming either way.
      </p>
      </div>
      <div class="card overflow-hidden fade-up hidden md:block">
        <img src="/assets/inline/wokingham-townhouse-bathroom.webp" alt="Finished luxury bathroom in a Wokingham townhouse conversion with a stone-effect floating vanity and concealed-cistern WC" width="800" height="600" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="section-sm">
    <div class="container max-w-3xl grid md:grid-cols-[1fr_280px] gap-8 items-start">
      <div>
      <h2 class="text-2xl font-bold mb-4 fade-up">What a fit-only installation involves in Wokingham</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        You choose and buy the bathroom; we work to the exact specification of those products, confirming dimensions and fixing centres before anything is delivered to site, rather than against a generic layout. On town-centre properties with limited parking, we also agree delivery timing and vehicle access in advance, which keeps the programme moving without disrupting neighbours or passing traffic.
      </p>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        On site, the job runs through strip-out, first-fix plumbing and electrics, tanking where required, tiling, and final fix and snagging. We protect flooring and staircases for the duration of the work with boards and sheeting, and leave the property clean and tidy at the end of each day — particularly important where we're sequencing around other trades on a wider renovation or extension.
      </p>
      </div>
      <div class="card overflow-hidden fade-up hidden md:block">
        <img src="/assets/inline/wokingham-timber-floor-check.webp" alt="Installer checking a suspended timber floor with a spirit level for deflection before tanking in a stripped-out Wokingham bathroom" width="800" height="600" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />
      </div>
    </div>
  </section>

  <!-- Planning -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Planning and conservation considerations</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        A standard internal bathroom refit — new sanitaryware, retiling, updated electrics — doesn't normally require planning permission. Where it can matter is on listed properties, or homes within Wokingham's town-centre conservation area, if the work affects the external fabric of the building — a new extraction vent through an original wall, for instance. If your property might be affected, we'll flag it plainly at survey and point you to the local planning authority to confirm before anything is ordered.
      </p>
      <p class="leading-relaxed" style="color: var(--text-soft);">
        Where a bathroom is part of a wider loft conversion or extension rather than a like-for-like refit, Building Regulations approval covering drainage, ventilation and electrical safety will usually apply regardless of whether planning permission is needed. We'll say so plainly if that applies to your project, so it can be arranged alongside the rest of the work.
      </p>
    </div>
  </section>

  <!-- Services available -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-6 fade-up">Services available in Wokingham</h2>
      <div class="grid md:grid-cols-2 gap-3">
        {services.slice(0, 10).map((s: { slug: string; name: string }) => (
          <a href={`/services/${s.slug}/`} class="card p-4 fade-up">
            <span class="font-medium text-sm">{s.name}</span>
          </a>
        ))}
      </div>
      <div class="mt-6 fade-up">
        <a href="/services/" class="font-semibold" style="color: var(--teal);">All services →</a>
      </div>
    </div>
  </section>

  <!-- Nearby areas -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-4 fade-up">Nearby areas</h2>
      <p class="leading-relaxed mb-4" style="color: var(--text-soft);">
        We also install in our Bracknell base, neighbouring Crowthorne — home to Wellington College — and the village of Twyford on the way towards Reading, all within a similar drive time.
      </p>
      <div class="flex flex-wrap gap-3 fade-up">
        <a href="/areas/bracknell/" class="btn-secondary">Bracknell</a>
        <a href="/areas/crowthorne/" class="btn-secondary">Crowthorne</a>
        <a href="/areas/twyford/" class="btn-secondary">Twyford</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-sm">
    <div class="container max-w-3xl">
      <h2 class="text-2xl font-bold mb-8 fade-up">Frequently asked questions</h2>
      <FAQ items={faqs} schemaId="wokingham-faq" />
    </div>
  </section>

  <!-- CTA -->
  <section class="section-sm" style="background: var(--bg-light);">
    <div class="container max-w-3xl text-center">
      <p class="leading-relaxed mb-6" style="color: var(--text-soft);">
        A £{business.pricing.surveyGBP} survey gets a qualified installer into your Wokingham property to measure the room, check floor and wall construction, test water pressure and confirm what your chosen products need for a correct installation. You'll come away with an itemised quote and a realistic programme before ordering anything.
      </p>
      <a href="/survey/" class="btn-primary">Book a Survey in Wokingham</a>
    </div>
  </section>

  <Footer slot="footer" />
  <StickyMobileCTA slot="sticky-cta" />
</Base>
