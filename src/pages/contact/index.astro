---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import StickyMobileCTA from "../../components/StickyMobileCTA.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { business } from "../../config/business.ts";

const budgetBands = [
  "From £3,500",
  "£10,000–£25,000",
  "£25,000–£50,000",
  "£50,000–£100,000",
  "£100,000+",
];

const propertyTypes = [
  "Detached house",
  "Semi-detached house",
  "Terraced house",
  "Period / listed property",
  "Flat or apartment",
  "Other",
];

const targetStarts = ["As soon as possible", "1–3 months", "3–6 months", "6–12 months", "Just researching"];
---

<Base
  title="Contact | Install My Bathroom"
  description="Get in touch about a fit-only bathroom installation in Bracknell and across Berkshire. Tell us about your project and we'll come back to you."
>
  <Header slot="header" />

  <section class="section-sm">
    <div class="container max-w-5xl">
      <Breadcrumbs items={[{ label: "Contact", href: "/contact/" }]} />
      <h1 class="text-4xl font-bold mb-4 fade-up">Contact</h1>
      <p class="text-lg leading-relaxed mb-10 max-w-2xl fade-up" style="color: var(--text-soft);">
        Tell us about your project and we'll come back to you — or book the £{business.pricing.surveyGBP} survey directly if you're ready to get a fixed quote.
      </p>

      <div class="grid md:grid-cols-[1fr_1.4fr] gap-10">
        <!-- NAP / details -->
        <div class="fade-up">
          <div class="card p-6 mb-6" style="background: var(--bg-light);">
            <h2 class="font-semibold text-lg mb-4">Get in touch directly</h2>
            <ul class="space-y-3 text-sm" style="color: var(--text-soft);">
              <li><a href={`tel:${business.phoneE164}`} class="font-medium" style="color: var(--teal);">{business.phone}</a></li>
              <li><a href={`mailto:${business.email}`} class="font-medium" style="color: var(--teal);">{business.email}</a></li>
              <li>{business.locality}, {business.region}, {business.postcode}</li>
            </ul>
          </div>
          <div class="card p-6" style="background: var(--bg-light);">
            <h2 class="font-semibold text-lg mb-2">Prefer to book a survey?</h2>
            <p class="text-sm mb-4" style="color: var(--text-soft);">
              The £{business.pricing.surveyGBP} survey gets you a written installation scope and a fixed quote.
            </p>
            <a href="/survey/" class="btn-primary">Book a Survey</a>
          </div>
        </div>

        <!-- Enquiry form -->
        <form
          name="enquiry"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          enctype="multipart/form-data"
          action="/thank-you/"
          class="card p-6 md:p-8 fade-up"
        >
          <input type="hidden" name="form-name" value="enquiry" />
          <input type="hidden" name="source" value="contact-page" />
          <p class="hidden">
            <label>Don't fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <div class="grid sm:grid-cols-2 gap-4 mb-4">
            <div>
              <label for="name" class="block text-sm font-medium mb-1">Name *</label>
              <input id="name" name="name" type="text" required class="w-full border rounded-lg px-3 py-2 text-sm" style="border-color: var(--border);" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium mb-1">Email *</label>
              <input id="email" name="email" type="email" required class="w-full border rounded-lg px-3 py-2 text-sm" style="border-color: var(--border);" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4 mb-4">
            <div>
              <label for="phone" class="block text-sm font-medium mb-1">Phone</label>
              <input id="phone" name="phone" type="tel" class="w-full border rounded-lg px-3 py-2 text-sm" style="border-color: var(--border);" />
            </div>
            <div>
              <label for="postcode" class="block text-sm font-medium mb-1">Postcode *</label>
              <input id="postcode" name="postcode" type="text" required class="w-full border rounded-lg px-3 py-2 text-sm" style="border-color: var(--border);" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4 mb-4">
            <div>
              <label for="propertyType" class="block text-sm font-medium mb-1">Property type</label>
              <select id="propertyType" name="propertyType" class="w-full border rounded-lg px-3 py-2 text-sm" style="border-color: var(--border);">
                {propertyTypes.map((p) => <option value={p}>{p}</option>)}
              </select>
            </div>
            <div>
              <label for="rooms" class="block text-sm font-medium mb-1">Which room(s)?</label>
              <input id="rooms" name="rooms" type="text" placeholder="e.g. main bathroom, en-suite" class="w-full border rounded-lg px-3 py-2 text-sm" style="border-color: var(--border);" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4 mb-4">
            <div>
              <label for="productsPurchased" class="block text-sm font-medium mb-1">Products already purchased?</label>
              <select id="productsPurchased" name="productsPurchased" class="w-full border rounded-lg px-3 py-2 text-sm" style="border-color: var(--border);">
                <option value="Yes">Yes, fully specified</option>
                <option value="Partly">Partly chosen</option>
                <option value="No">Not yet</option>
              </select>
            </div>
            <div>
              <label for="brands" class="block text-sm font-medium mb-1">Brands (if known)</label>
              <input id="brands" name="brands" type="text" placeholder="e.g. Geberit, hansgrohe" class="w-full border rounded-lg px-3 py-2 text-sm" style="border-color: var(--border);" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4 mb-4">
            <div>
              <label for="targetStart" class="block text-sm font-medium mb-1">Target start</label>
              <select id="targetStart" name="targetStart" class="w-full border rounded-lg px-3 py-2 text-sm" style="border-color: var(--border);">
                {targetStarts.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>
            <div>
              <label for="budgetBand" class="block text-sm font-medium mb-1">Budget band</label>
              <select id="budgetBand" name="budgetBand" class="w-full border rounded-lg px-3 py-2 text-sm" style="border-color: var(--border);">
                {budgetBands.map((b) => <option value={b}>{b}</option>)}
              </select>
            </div>
          </div>

          <div class="mb-4">
            <label for="message" class="block text-sm font-medium mb-1">Tell us about your project</label>
            <textarea id="message" name="message" rows="4" class="w-full border rounded-lg px-3 py-2 text-sm" style="border-color: var(--border);"></textarea>
          </div>

          <div class="mb-6">
            <label for="photo" class="block text-sm font-medium mb-1">Photo of the space (optional)</label>
            <input id="photo" name="photo" type="file" accept="image/*" class="w-full text-sm" />
          </div>

          <button type="submit" class="btn-primary w-full justify-center">Send Enquiry</button>
        </form>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
  <StickyMobileCTA slot="sticky-cta" />
</Base>
