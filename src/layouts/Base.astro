---
import "../styles/global.css";
import heroManifest from "../../public/hero-manifest.json";
import altTagsData from "../data/alt-tags.json";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import BusinessSchema from "../components/BusinessSchema.astro";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  noHero?: boolean; // pass true on pages with their own custom hero section
  noindex?: boolean; // pass true on utility pages (e.g. /thank-you/) that shouldn't be indexed
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage,
  noHero = false,
  noindex = false,
} = Astro.props;

const resolvedCanonical = canonical ?? Astro.url.href;
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;

// Derive slug from URL (strip leading + trailing slashes)
const pathSlug = Astro.url.pathname.replace(/^\//, "").replace(/\/$/, "");
const heroSrc: string | undefined = (heroManifest as Record<string, string>)[pathSlug];
const hasRealHero = Boolean(heroSrc);
const heroAlt: string =
  (altTagsData as Record<string, string>)[pathSlug] ??
  "Luxury bathroom installation — Install My Bathroom";

// og:image priority: explicit prop > page hero (absolute) > logo
const SITE = "https://installmybathroom.co.uk";
const resolvedOgImage =
  ogImage ??
  (hasRealHero ? `${SITE}${heroSrc}` : `${SITE}/brand/imb-logo.webp`);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- Google tag (gtag.js) — script itself loaded after window `load` so it
         doesn't compete with critical-path requests / main thread during initial render. -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7DY4W7ZMZL');

      function imbLoadGtag() {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-7DY4W7ZMZL';
        document.head.appendChild(s);
      }
      window.imbRunAfterLoad = window.imbRunAfterLoad || [];
      window.imbRunAfterLoad.push(imbLoadGtag);
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Install My Bathroom" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0F766E" />

    <!-- Fonts and chat-widget CSS — both non-critical for first paint (the page's
         own Tailwind stylesheet is what the layout actually depends on). Queued
         to run after window `load` (same queue as the gtag script above) so
         they never compete for bandwidth with that critical stylesheet or the
         LCP hero image on slow connections — DOMContentLoaded fires as soon as
         HTML parsing finishes, which is too early (well before Footer.css or
         the hero image have actually finished downloading); `load` is the
         first point nothing critical is still in flight. <noscript> covers the
         no-JS case. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script>
      function imbLoadNonCriticalStyles() {
        function loadStylesheet(href) {
          var link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = href;
          document.head.appendChild(link);
        }
        loadStylesheet("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap");
        loadStylesheet("/css/chat-widget.css");
      }
      window.imbRunAfterLoad = window.imbRunAfterLoad || [];
      window.imbRunAfterLoad.push(imbLoadNonCriticalStyles);

      (function () {
        function runQueue() {
          window.imbRunAfterLoad.forEach(function (fn) { fn(); });
        }
        if (document.readyState === "complete") {
          runQueue();
        } else {
          window.addEventListener("load", runQueue);
        }
      })();
    </script>
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      />
      <link rel="stylesheet" href="/css/chat-widget.css" />
    </noscript>

    <!-- Global styles are injected by Astro via the frontmatter import below.
         DECISION: Imported in frontmatter (not <link>) so Astro/Vite bundles and
         fingerprints the CSS at build time. The <style> tag approach would scope it. -->

    <!-- Site-wide business identity, present on every page (matching @id lets
         Google merge these into one entity rather than treating each as separate). -->
    <BusinessSchema />

    <!-- Page-specific schema slot (FAQPage, BreadcrumbList, Service, etc.) -->
    <slot name="schema" />
  </head>

  <body>
    <!-- Header -->
    <slot name="header" />

    <!-- Page hero image (manifest-driven, skipped on pages with custom heroes) -->
    {!noHero && hasRealHero && (
      <div style="width:100%;height:clamp(240px,38vw,520px);overflow:hidden;line-height:0;">
        <img
          src={heroSrc}
          srcset={`${heroSrc.replace(".webp", "-480w.webp")} 480w, ${heroSrc.replace(".webp", "-768w.webp")} 768w, ${heroSrc.replace(".webp", "-1200w.webp")} 1200w, ${heroSrc} 1834w`}
          sizes="100vw"
          alt={heroAlt}
          width="1834"
          height="1024"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          style="width:100%;height:100%;object-fit:cover;object-position:center;display:block;"
        />
      </div>
    )}

    <!-- Main content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <slot name="footer" />

    <!-- Sticky mobile CTA (Call / Book Survey / Enquire) — page opt-in -->
    <slot name="sticky-cta" />

    <!-- WhatsApp floating button — visible on all pages -->
    <WhatsAppButton />

    <!-- Amy chat widget — visible on all pages -->
    <script src="/js/chat-widget.js" defer></script>

    <!-- Gold glow cursor + stardust trail -->
    <canvas id="fx-canvas" aria-hidden="true" style="position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999;"></canvas>
    <script>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const canvas = document.getElementById('fx-canvas');
        const ctx = canvas.getContext('2d');

        let W = canvas.width  = window.innerWidth;
        let H = canvas.height = window.innerHeight;
        window.addEventListener('resize', () => {
          W = canvas.width  = window.innerWidth;
          H = canvas.height = window.innerHeight;
        });

        let mx = -300, my = -300, active = false;
        const particles = [];

        // Gold palette
        const golds = ['#D4A017','#F0C040','#FFD700','#E8B84B','#FFC857','#FFAA00'];

        function spawn(x, y, count) {
          for (let i = 0; i < count; i++) {
            const angle = Math.random() * Math.PI * 2;
            const speed = 0.4 + Math.random() * 1.8;
            particles.push({
              x, y,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed - 0.6,
              life: 1,
              decay: 0.018 + Math.random() * 0.025,
              size: 1.5 + Math.random() * 3,
              color: golds[Math.floor(Math.random() * golds.length)],
            });
          }
        }

        let frame = 0;
        function draw() {
          requestAnimationFrame(draw);
          ctx.clearRect(0, 0, W, H);

          // Glow orb at cursor
          if (active) {
            const g = ctx.createRadialGradient(mx, my, 0, mx, my, 28);
            g.addColorStop(0,   'rgba(255,215,0,0.55)');
            g.addColorStop(0.4, 'rgba(212,160,23,0.25)');
            g.addColorStop(1,   'rgba(212,160,23,0)');
            ctx.beginPath();
            ctx.arc(mx, my, 28, 0, Math.PI * 2);
            ctx.fillStyle = g;
            ctx.fill();

            // Inner bright dot
            ctx.beginPath();
            ctx.arc(mx, my, 4, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255,230,80,0.9)';
            ctx.fill();

            // Spawn particles while moving
            if (frame % 2 === 0) spawn(mx, my, 2);
          }

          // Draw + age particles
          for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.x  += p.vx;
            p.y  += p.vy;
            p.vy += 0.04; // gentle gravity
            p.life -= p.decay;
            if (p.life <= 0) { particles.splice(i, 1); continue; }

            ctx.globalAlpha = p.life * 0.85;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
            ctx.fillStyle = p.color;
            ctx.fill();
          }
          ctx.globalAlpha = 1;
          frame++;
        }

        // Mouse
        document.addEventListener('mousemove', e => {
          mx = e.clientX; my = e.clientY; active = true;
          spawn(mx, my, 1);
        });
        document.addEventListener('mouseleave', () => { active = false; });

        // Touch
        document.addEventListener('touchstart', e => {
          mx = e.touches[0].clientX; my = e.touches[0].clientY; active = true;
          spawn(mx, my, 4);
        }, { passive: true });
        document.addEventListener('touchmove', e => {
          mx = e.touches[0].clientX; my = e.touches[0].clientY;
          spawn(mx, my, 3);
        }, { passive: true });
        document.addEventListener('touchend', () => {
          // Burst on lift
          spawn(mx, my, 10);
          setTimeout(() => { active = false; }, 400);
        }, { passive: true });

        draw();
      })();
    </script>

    <!-- Fade-up animation (IntersectionObserver, respects prefers-reduced-motion).
         Elements already inside the initial viewport (hero copy, above-the-fold
         CTAs) are shown immediately instead of waiting for the observer + the
         0.6s opacity transition — that delay was making whichever fade-up
         element happened to be largest above the fold the LCP candidate, adding
         ~1s of pure animation delay on top of its actual render time. -->
    <script>
      (function () {
        const elements = document.querySelectorAll(".fade-up");
        const prefersReduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        if (prefersReduced) {
          elements.forEach((el) => el.classList.add("visible"));
          return;
        }

        const viewportHeight = window.innerHeight;
        // Read all geometry first, then write all classList changes — avoids
        // forced-reflow thrashing from interleaving reads/writes per element.
        const tops = Array.from(elements, (el) => el.getBoundingClientRect().top);
        const toObserve = [];

        elements.forEach((el, i) => {
          if (tops[i] < viewportHeight) {
            el.classList.add("visible", "fade-up-instant");
          } else {
            toObserve.push(el);
          }
        });

        if (!toObserve.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );

        toObserve.forEach((el) => observer.observe(el));
      })();
    </script>
  </body>
</html>
